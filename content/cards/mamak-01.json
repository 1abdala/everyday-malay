  "chips": [
    {
      "id": "mamak-01-comparison-001",
      "spoken": "nak",
      "formal": "hendak, mahu",
      "note": "daily speech vs. writing and speeches"
    },
    {
      "id": "mamak-01-comparison-002",
      "spoken": "tu je",
      "formal": "itu saja",
      "note": "Teach the full form ‘Itu saja’ first, followed by the colloquial shortened form ‘Tu je’."
    },
    {
      "id": "mamak-01-comparison-003",
      "spoken": "lebih",
      "formal": "lebih",
      "note": "Roti canai is normally served with dhal by default; ‘kuah dhal lebih’ requests extra gravy rather than a standard serving. ‘Tambah dhal’ is another natural alternative."
    },
    {
      "id": "mamak-01-comparison-004",
      "spoken": "ke",
      "formal": "atau",
      "note": "\"or\" in questions: makan sini ke tapau?"
    },
    {
      "id": "mamak-01-comparison-005",
      "spoken": "tapau",
      "formal": "bungkus",
      "note": "takeaway, at stalls"
    },
    {
      "id": "mamak-01-comparison-006",
      "spoken": "kira",
      "formal": "minta bil (contextual)",
      "note": "In this mamak exchange, ‘kira’ asks the staff to total the bill; it is not a universal synonym for bayar or minta bil."
    }
  ],
